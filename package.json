{
  "name": "app-builder-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev",
    "build": "node scripts/with-app-env.mjs vite build && node scripts/fix-css-asset.mjs && npm run db:migrate",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "db:migrate": "node scripts/migrate.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  }
}
